generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id        String   @id @default(uuid())
  username  String   @unique
  email     String?  @unique
  phone     String?
  password  String
  role      String   @default("PUBLIC") // ADMIN, TEACHER, STUDENT, PARENT, PUBLIC
  name      String
  status    String   @default("ACTIVE") // ACTIVE, DISABLED
  requiresPasswordChange Boolean @default(true)
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  // Relations
  materials       Material[]
  comments        ReviewComment[]
  teacherProfile  TeacherProfile?
  studentProfile  StudentProfile?
  teacherConnectSessions   TeacherConnectSession[] @relation("SessionTeacher")
  teacherConnectResources  TeacherConnectResource[] @relation("ResourceTeacher")
}

model TeacherProfile {
  id        String @id @default(uuid())
  userId    String @unique
  user      User   @relation(fields: [userId], references: [id])
  
  // Storing as JSON string or comma-separated for simple array
  subjects  String // e.g., "Mathematics,Science"
  grades    String // e.g., "Grade 10,Grade 11"
}

// Future LMS - Student Profile
model StudentProfile {
  id        String @id @default(uuid())
  userId    String @unique
  user      User   @relation(fields: [userId], references: [id])
}

model Material {
  id           String   @id @default(uuid())
  title        String
  description  String?
  academicYear String
  grade        String
  subject      String
  chapterNo    Int
  chapterName  String
  type         String   // YOUTUBE, PDF, PPT, DOCX, IMAGE, VIDEO, EXTERNAL_LINK, ZIP
  urlOrPath    String
  
  status       String   @default("ACTIVE") // ACTIVE, ARCHIVED, DRAFT
  version      Int      @default(1)
  
  uploaderId   String
  uploader     User     @relation(fields: [uploaderId], references: [id])
  
  comments     ReviewComment[]
  
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  
  isDeleted    Boolean  @default(false)
}

model ReviewComment {
  id         String   @id @default(uuid())
  content    String
  
  materialId String
  material   Material @relation(fields: [materialId], references: [id])
  
  authorId   String
  author     User     @relation(fields: [authorId], references: [id])
  
  createdAt  DateTime @default(now())
}

// Future LMS expansion placeholders
model Class {
  id           String @id @default(uuid())
  grade        String
  academicYear String
  sections     Section[]
}

model Section {
  id      String @id @default(uuid())
  name    String
  classId String
  class   Class  @relation(fields: [classId], references: [id])
}

model TeacherConnectSession {
  id            String   @id @default(uuid())
  teacherId     String
  teacher       User     @relation("SessionTeacher", fields: [teacherId], references: [id])
  transferCode  String   @unique
  expiresAt     DateTime
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
}

model TeacherConnectResource {
  id                  String   @id @default(uuid())
  teacherId           String
  teacher             User     @relation("ResourceTeacher", fields: [teacherId], references: [id])
  title               String?
  notes               String?
  resourceUrl         String
  resourceType        String   // YOUTUBE, PDF, IMAGE, VIDEO, DRIVE, WEBSITE, UNKNOWN
  status              String   @default("inbox") // inbox, published, archived, deleted
  publishedMaterialId String?  
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  archivedAt          DateTime?
  deletedAt           DateTime?
}

